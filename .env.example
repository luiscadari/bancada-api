# Copy to .env and adjust. docker compose reads .env automatically.

# PostgreSQL roles (created by db/init/00-roles.sh on the first start of the volume)
POSTGRES_PASSWORD=postgres_dev
BANCADA_OWNER_PASSWORD=owner_dev
BANCADA_APP_PASSWORD=app_dev
BANCADA_SYSTEM_PASSWORD=system_dev

# API
APP_ENV=development
LOG_LEVEL=info
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Base64 of exactly 32 bytes. Generate with: openssl rand -base64 32
DEVICE_PASSWORD_KEY=ZGV2LW9ubHktZGV2aWNlLXBhc3N3b3JkLWtleS0zMmI=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Host ports
DB_PORT=5432
API_PORT=8080

# Running the API outside Docker (go run ./cmd/api):
# DATABASE_URL=postgres://bancada_app:app_dev@localhost:5432/bancada?sslmode=disable
# SYSTEM_DATABASE_URL=postgres://bancada_system:system_dev@localhost:5432/bancada?sslmode=disable
# MIGRATION_DATABASE_URL=postgres://bancada_owner:owner_dev@localhost:5432/bancada?sslmode=disable
